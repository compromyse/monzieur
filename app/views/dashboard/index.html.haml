.space-y-10
  %h1.text-3xl.font-bold.text-gray-900 Client Operations
  %p.text-lg.text-gray-500= "#{@visit_count} visit(s) today"

  #searcharticle
    -# TODO: Scan functionality
    %select.w-full.px-4.py-3.text-xl.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{ id: 'search', placeholder: 'Search by Name or Mobile Number..' }

  .flex.flex-wrap.gap-4
    = link_to "Register a New Client", new_client_path, class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 transition-colors"
    = link_to "Visit History", visits_path, class: "px-6 py-3 text-lg font-medium text-gray-900 underline"
    = link_to "Bulk Intake Form", intake_form_bulk_index_path, data: { turbo: false }, class: "px-6 py-3 text-lg font-medium text-gray-900 underline"

  - if Current.user.admin?
    .space-y-4
      %p.text-sm.font-semibold.text-gray-500.uppercase.tracking-widest Admin Operations
      .space-y-2
        = link_to edit_pantry_path(Current.pantry.id), class: "flex items-center justify-between px-6 py-5 border-2 border-gray-900 hover:bg-gray-100 transition-colors" do
          %span.text-2xl.font-bold.text-gray-900 Edit Pantry
          %span.text-gray-500 →
        = link_to pantry_users_path, class: "flex items-center justify-between px-6 py-5 border-2 border-gray-900 hover:bg-gray-100 transition-colors" do
          %span.text-2xl.font-bold.text-gray-900 Manage Users
          %span.text-gray-500 →
        = link_to import_csv_form_imports_path, class: "flex items-center justify-between px-6 py-5 border-2 border-gray-900 hover:bg-gray-100 transition-colors" do
          %span.text-2xl.font-bold.text-gray-900 Import Data
          %span.text-gray-500 →

:javascript
  new TomSelect('#search',{
          valueField: 'uuid',
          labelField: 'first_name',
          searchField: [ 'first_name', 'last_name', 'mobile_number' ],

          load: function(query, callback) {

            var url = "#{find_clients_path}?q=" + encodeURIComponent(query);
              fetch(url)
                  .then(response => response.json())
                  .then(json => {
                      callback(json);
                  })

          },
          
          onItemAdd: function(uuid) {
            document.getElementById('searcharticle').innerHTML = '';
            document.getElementById('searcharticle').ariaBusy = 'true';
            window.location.href = "#{show_clients_path}?uuid=" + uuid;
          },

          render:{
            item: function(data, escape) {
              return `<div>${data.first_name} ${data.last_name} (${data.mobile_number})</div>`
            },
            option: function(data, escape) {
              return `<div>${data.first_name} ${data.last_name} (${data.mobile_number})</div>`
            },
          }

      });

  document.addEventListener('DOMContentLoaded', function() {
    document.getElementById("search-ts-control").focus();
  }, false);
