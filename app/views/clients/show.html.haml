.space-y-10
  .flex.items-center.justify-between.flex-wrap.gap-4
    %h1.text-3xl.font-bold.text-gray-900 Client Information
    .flex.gap-4.flex-wrap
      = link_to "QR Code", qr_clients_path(id: @client.id), target: "_blank", class: "text-lg font-medium text-gray-900 underline"
      = link_to "Agreement", agreement_clients_path(uuid: @client.uuid), target: "_blank", class: "text-lg font-medium text-gray-900 underline"
      = link_to "TEFAP Attestation", tefap_attestation_clients_path(uuid: @client.uuid), target: "_blank", class: "text-lg font-medium text-gray-900 underline"
      = link_to "Intake", intake_form_clients_path(uuid: @client.uuid), target: "_blank", class: "text-lg font-medium text-gray-900 underline"
      = link_to "Edit", edit_client_path(id: @client.id), class: "text-lg font-medium text-gray-900 underline"

  - if @client.member_counts.values.sum != @client.household_members.count + 1
    .px-4.py-3.bg-red-100.border.border-red-300.text-red-900.text-lg.text-center
      Warning: the calculated household member count doesn't equal the sum of the household member counts entered

  .space-y-2
    %p.text-lg.text-gray-900
      %span.text-gray-500 First Name:
      = @client.first_name
    %p.text-lg.text-gray-900
      %span.text-gray-500 Last Name:
      = @client.last_name
    %p.text-lg.text-gray-900
      %span.text-gray-500 Mobile Number:
      = @client.mobile_number
    %p.text-lg.text-gray-900
      %span.text-gray-500 Address:
      = @client.address or '-'
    %p.text-lg.text-gray-900
      %span.text-gray-500 Last Visit:
      = @client.last_visit

  %div
    %h3.text-xl.font-semibold.text-gray-900.mb-4 Household Members

    %table.w-full.text-lg.mb-6
      %thead
        %tr.border-b-2.border-gray-900
          - HouseholdMember::MEMBER_TYPES.values.each do |t|
            %th.text-left.py-2= t
      %tbody
        %tr.border-b.border-gray-200
          - HouseholdMember::MEMBER_TYPES.keys.each do |t|
            %td.py-3= @client.member_counts[t.to_s]
        %tr
          %td.py-3.text-right{ colspan: HouseholdMember::MEMBER_TYPES.keys.count }
            Total:
            = @client.member_counts.values.sum
            (incl. client)

    %table.w-full.text-lg
      %thead
        %tr.border-b-2.border-gray-900
          %th.text-left.py-2 First Name
          %th.text-left.py-2 Last Name
      %tbody
        - @client.household_members.each do |member|
          %tr.border-b.border-gray-200
            %td.py-3= member.first_name
            %td.py-3= member.last_name

  .space-y-2
    %p.text-xl.font-medium.text-gray-900 Notes
    %p.text-lg.text-gray-700= @client.notes

  = button_to "Log Visit", visits_path(visit: { client_id: @client.id }), data: { 'turbo-confirm': 'Are you sure?' }, class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors"

%details.mt-8
  %summary.text-lg.font-medium.text-gray-900.underline.cursor-pointer View History

  = turbo_frame_tag "show_history", src: visit_history_clients_path(uuid: @client.uuid, format: :turbo_stream), action: :replace, loading: :lazy
