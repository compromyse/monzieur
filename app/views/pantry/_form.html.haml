%h3.text-xl.font-semibold.text-gray-900 Pantry Information

.space-y-6
  = f.input :name, label: "Name", wrapper_html: { class: "space-y-2" },
      label_html: { class: "block text-xl font-medium text-gray-900" },
      input_html: { class: "w-full px-4 py-3 text-xl border-2 border-gray-400 focus:border-gray-900 focus:outline-none" }
  = f.input :address, label: "Address", wrapper_html: { class: "space-y-2" },
      label_html: { class: "block text-xl font-medium text-gray-900" },
      input_html: { class: "w-full px-4 py-3 text-xl border-2 border-gray-400 focus:border-gray-900 focus:outline-none" }
